---
// src/components/Navbar.astro
const links = [
  { href: '#services', label: 'Services' },
  { href: '#specialty', label: 'Coating & PPF' },
  { href: '#process', label: 'Proses' },
  { href: '#location', label: 'Lokasi' },
  { href: '#membership', label: 'Membership' },
];
---

<header
  id="site-nav"
  class="group fixed top-0 inset-x-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-500 data-[scrolled]:bg-bay/92 data-[scrolled]:backdrop-blur-md data-[scrolled]:border-frost/10"
>
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between px-5 sm:px-8">
    <a href="#top" class="flex items-center gap-3" aria-label="AutoGleam Detailing — beranda">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="text-lamp">
        <path fill="currentColor" d="M12 0C12.7 6.6 17.4 11.3 24 12C17.4 12.7 12.7 17.4 12 24C11.3 17.4 6.6 12.7 0 12C6.6 11.3 11.3 6.6 12 0Z"/>
      </svg>
      <span class="wide-caps text-[0.8rem] leading-none tracking-[0.16em] text-frost sm:text-[0.95rem] sm:tracking-[0.2em]">AutoGleam</span>
    </a>

    <nav class="hidden items-center gap-9 lg:flex" aria-label="Navigasi utama">
      {links.map((l) => (
        <a href={l.href} class="text-[0.8rem] tracking-wide text-mist-2 transition-colors hover:text-frost">{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a href="#booking" class="btn btn-lamp !px-4 !py-2.5 sm:!px-5"><span class="sm:hidden">Book</span><span class="hidden sm:inline">Book Service</span></a>
      <details class="relative lg:hidden">
        <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-sm border border-frost/20 text-frost [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
        </summary>
        <div class="absolute right-0 top-12 w-60 border border-frost/10 bg-bay-2 p-2">
          {links.map((l) => (
            <a href={l.href} class="block px-4 py-3 text-sm text-mist-2 hover:bg-bay-3 hover:text-frost">{l.label}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
